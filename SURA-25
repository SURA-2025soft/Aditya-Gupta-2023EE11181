double feedback(double V_feedback, double time, double T_switch) {
if (fmod(time * 1e7, T_switch * 1e7) == 0.0){ // to get the peak values of the feedback
     if(V_feedback <0){
     V_new = -1*V_feedback;
     }else{
     V_new = V_feedback; 
      }
}
return V_new;
}

